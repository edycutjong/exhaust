fn unpack(_ x: u32) -> State {
    State {
        phase: phase_of(x >> 24),
        escrow: (x >> 16) & 255,
        seller: (x >> 8) & 255,
        buyer: x & 255,
    }
}

fn pack(_ s: State) -> u32 {
    (phase_id(s.phase) << 24) | (s.escrow << 16) | (s.seller << 8) | s.buyer
}

/// step() agrees with the oracle on every row: same accept/reject, same next state, field by field.
#[test]
fn test_oracle_edges() {
    var i: usize = 0
    var accepted: u32 = 0
    while i < black_box(ROWS) {
        let n = step(unpack(FROM[i]), action_of(ACT[i]), CAP_TABLE)
        assert!((n.ok && OKS[i] == 1) || (!n.ok && OKS[i] == 0))
        assert!(pack(n.s) == TO[i])
        if n.ok { accepted += 1 }
        i += 1
    }
    assert!(accepted == 966)
}
