//! The explorer: a breadth-first search over every state reachable from the start state through `step()`,
//! written as a `const fn` so that `static_assert` runs it inside `fe build`.
//!
//! Budget: Fe 26.6.0 evaluates each `static_assert` with its own limit of 1,000,000 evaluator steps. Array
//! initialisation costs about one step per element, so the two tables below cost ~85k steps before the search
//! starts. Consts that reference other consts share one budget (evidence/probes-*.txt), so each search is its own
//! `static_assert`.

use ingot::escrow::{
    step,
    encode,
    decode,
    action_of,
    state_violation,
    first_violation,
    SIZE,
    W,
    ACTIONS,
    INIT,
    CAP,
    OK,
    WITHIN_CAPACITY,
    IN_BOUNDS,
    PAID_ONCE,
    SETTLED_EMPTY,
    CONSERVED,
}

/// Turns an invariant id into a compile error that names the invariant (called only when `v != OK`).
const fn require(_ v: u8) {
    assert!(
        v != WITHIN_CAPACITY,
        "invariant 'within capacity' broken: more units than the capacity",
    )
    assert!(
        v != IN_BOUNDS,
        "invariant 'in bounds' broken: state outside the encoding",
    )
    assert!(
        v != PAID_ONCE,
        "invariant 'paid once' broken: buyer and seller both paid",
    )
    assert!(
        v != SETTLED_EMPTY,
        "invariant 'settled empty' broken: settled with units still in escrow",
    )
    assert!(
        v != CONSERVED,
        "invariant 'conserved' broken: units created or lost by a non-deposit action",
    )
}

/// Number of states reachable from the initial state at capacity `cap`.
pub const fn explore(_ cap: u32) -> usize {
    explore_from(INIT, cap)
}

/// Number of states reachable from `start` (an encoded state) at capacity `cap`. Fails the evaluation, naming
/// the invariant, if any reachable state or edge breaks one.
pub const fn explore_from(_ start: u32, _ cap: u32) -> usize {
    explore_seeds(start, 1, 0, cap)
}

/// Encoding of (Locked, k, 0, 0) is `LOCKED_BASE + k * LOCKED_STRIDE`: the seeds of the locked-amount shards.
pub const LOCKED_BASE: u32 = W * W * W
pub const LOCKED_STRIDE: u32 = W * W

/// Number of states reachable from the `count` seeds `first`, `first + stride`, ... (encoded states) at capacity
/// `cap`, each seed counted once. Fails the evaluation, naming the invariant, if any reachable state or edge
/// breaks one.
pub const fn explore_seeds(_ first: u32, _ count: u32, _ stride: u32, _ cap: u32) -> usize {
    var visited: [bool; SIZE] = [false; SIZE]
    // Each index is enqueued only when it is first marked visited, so the queue never holds more than SIZE.
    var queue: [u32; SIZE] = [0; SIZE]
    var head: usize = 0
    var tail: usize = 0
    var i: u32 = 0
    while i < count {
        let x0 = first + i * stride
        let v0 = state_violation(decode(x0), cap)
        if v0 != OK { require(v0) }
        if !visited[x0 as usize] {
            visited[x0 as usize] = true
            queue[tail] = x0
            tail += 1
        }
        i += 1
    }
    while head < tail {
        let x = queue[head]
        head += 1
        let cur = decode(x)
        var a: u32 = 0
        while a < ACTIONS {
            let act = action_of(a)
            let n = step(cur, act, cap)
            if n.ok {
                // Every invariant is checked before `encode`, so an out-of-box successor fails by name.
                let v = first_violation(cur, act, n.s, cap)
                if v != OK { require(v) }
                let y = encode(n.s)
                if !visited[y as usize] {
                    visited[y as usize] = true
                    queue[tail] = y
                    tail += 1
                }
            }
            a += 1
        }
    }
    tail
}

/// Code returned when the start state itself breaks an invariant (no action uses the digit 9).
pub const START_VIOLATES: u256 = 9

/// The same search, recording each state's parent and the action that reached it. Returns the first shortest
/// counterexample under the declared action order, across all checked invariants, as decimal digits (earliest
/// action first; legend in `escrow.fe`), or 0 when no reachable state or edge breaks an invariant.
pub const fn counterexample(_ cap: u32) -> u256 {
    if state_violation(decode(INIT), cap) != OK {
        return START_VIOLATES
    }
    var visited: [bool; SIZE] = [false; SIZE]
    var parent: [u32; SIZE] = [0; SIZE]
    var via: [u8; SIZE] = [0; SIZE]
    var queue: [u32; SIZE] = [0; SIZE]
    var head: usize = 0
    var tail: usize = 1
    queue[0] = INIT
    visited[INIT as usize] = true
    while head < tail {
        let x = queue[head]
        head += 1
        let cur = decode(x)
        var a: u32 = 0
        while a < ACTIONS {
            let act = action_of(a)
            let n = step(cur, act, cap)
            if n.ok {
                if first_violation(cur, act, n.s, cap) != OK {
                    // BFS order: this edge ends the shortest path to a violation. Walk back from the current state.
                    var code: u256 = (a + 1) as u256
                    var mul: u256 = 10
                    var len: u32 = 1
                    var p = x
                    while p != INIT {
                        len += 1
                        // A u256 holds every decimal number of at most 77 digits; stop before the multiplication overflows.
                        assert!(
                            len <= 76,
                            "trace longer than 76 actions: shrink the configuration to print it",
                        )
                        code += (via[p as usize] as u256) * mul
                        mul *= 10
                        p = parent[p as usize]
                    }
                    return code
                }
                let y = encode(n.s)
                if !visited[y as usize] {
                    visited[y as usize] = true
                    parent[y as usize] = x
                    via[y as usize] = (a + 1).downcast_truncate()
                    queue[tail] = y
                    tail += 1
                }
            }
            a += 1
        }
    }
    0
}

/// Modulus and multiplier of the labeled-edge hash (MODEL.md): M = 2^61 - 1, P = 1,000,003.
pub const HASH_M: u128 = 2305843009213693951
pub const HASH_P: u128 = 1000003

/// The same breadth-first search without invariant checks (`explore` already checks them), folding every accepted
/// labeled edge (s, a, s') in search order. `hash == false`: returns the number of accepted edges. `hash == true`:
/// returns h, where h = (h * P + ((enc(s) * 5 + a) * SIZE + enc(s'))) mod M, computed in u128 so no step overflows.
/// A wrong successor that keeps the state set and the edge count (two successors swapped) still changes h.
/// The search stops and returns DEFERRED as soon as it reaches more than `max_states` states: such a model already
/// fails `explore` (by an invariant or by the state pin), and without the stop a larger buggy graph would only add a
/// step-limit error to the build output. The edge pins therefore rely on the `explore(CAP) == STATES` pin: keep it. A
/// model with FEWER states is searched in full, so it fails the edge pins with its real values as well.
pub const fn fingerprint(_ cap: u32, _ hash: bool, _ max_states: usize) -> u128 {
    var visited: [bool; SIZE] = [false; SIZE]
    var queue: [u32; SIZE] = [0; SIZE]
    var head: usize = 0
    var tail: usize = 1
    var acc: u128 = 0
    queue[0] = INIT
    visited[INIT as usize] = true
    while head < tail {
        let x = queue[head]
        head += 1
        let cur = decode(x)
        var a: u32 = 0
        while a < ACTIONS {
            let n = step(cur, action_of(a), cap)
            if n.ok {
                let y = encode(n.s)
                if hash {
                    let label: u128 = ((x as u128) * (ACTIONS as u128) + (a as u128)) * SIZE_U128
                        + (y as u128)
                    acc = (acc * HASH_P + label) % HASH_M
                } else {
                    acc += 1
                }
                if !visited[y as usize] {
                    if tail == max_states {
                        return DEFERRED
                    }
                    visited[y as usize] = true
                    queue[tail] = y
                    tail += 1
                }
            }
            a += 1
        }
    }
    acc
}

/// SIZE as a u128 (a usize-to-u128 cast is rejected as not provably lossless); the assert ties the two.
const SIZE_U128: u128 = 42592
static_assert(SIZE == 42592)

/// Returned by `fingerprint` for a model with more states than its bound (no real count or hash is this large).
pub const DEFERRED: u128 = 0xffffffffffffffffffffffffffffffff

/// The value an edge pin compares: the fingerprint, or the pinned value itself when the search deferred to `explore`.
pub const fn or_deferred(_ got: u128, _ pin: u128) -> u128 {
    if got == DEFERRED { pin } else { got }
}

/// Reachable states at C = CAP (also the bound of the edge-pin searches).
pub const STATES: usize = 736
/// Accepted edges at C = CAP, and their labeled-edge hash (MODEL.md); both values come from tools/ref_model.py.
pub const EDGES: u128 = 966
pub const EDGE_HASH: u128 = 1194004490208706542

// ---- pins: the build fails if the reachable-state count drifts ----
/// C = 17: the capacity of the first pin, carried over from the day-0 spike (494 states).
static_assert(explore(17) == 494)
/// C = CAP = 21: the contract's capacity and the largest capacity the encoding holds (MAX_CAP). Every invariant is
/// checked on every reachable state and accepted edge; this fits one assert's budget on Fe 26.6.0 (evidence/budget.md).
static_assert(explore(CAP) == STATES)
/// C' = 19: the attack printer. Green it is a full search with parent/action writes (four tables), so it costs more
/// per state than `explore`. C = 20 fits with 1.6% of the budget to spare and C = 21 exceeds it (evidence/budget.md);
/// 19 leaves room for edits to step() (conformance K2 adds two branches and still fits).
static_assert(counterexample(19) == 0)
/// C_hash = 21: the number of accepted edges and the labeled-edge hash. Both searches
/// stop past STATES states and then defer to the `explore(CAP)` pin above, which already fails for such a model.
static_assert(or_deferred(fingerprint(CAP, false, STATES), EDGES) == EDGES)
static_assert(or_deferred(fingerprint(CAP, true, STATES), EDGE_HASH) == EDGE_HASH)

// ---- shards: the same reachable set split into disjoint parts, each in its own static_assert (own budget) ----
// After Lock the total never changes (only Deposit adds a unit, and only while Open), so the states reachable from
// (Locked, k, 0, 0) all have total k: shards with different k share no state. Every reachable state is either one
// of the C + 1 Open states (Open, k, 0, 0) or reachable from some (Locked, k, 0, 0), k = 1..C. The runtime test
// test_shards_partition checks the sum on both backends; tools/ref_model.py checks disjointness and the union.
/// Shard A: locked amount k = 1..7.
static_assert(explore_seeds(LOCKED_BASE + LOCKED_STRIDE, 7, LOCKED_STRIDE, CAP) == 91)
/// Shard B: locked amount k = 8..14.
static_assert(explore_seeds(LOCKED_BASE + 8 * LOCKED_STRIDE, 7, LOCKED_STRIDE, CAP) == 238)
/// Shard C: locked amount k = 15..21.
static_assert(explore_seeds(LOCKED_BASE + 15 * LOCKED_STRIDE, 7, LOCKED_STRIDE, CAP) == 385)
