//! The explorer: a breadth-first search over every state reachable from the start state through `step()`,
//! written as a `const fn` so that `static_assert` runs it inside `fe build`.
//!
//! Budget: Fe 26.6.0 evaluates each `static_assert` with its own limit of 1,000,000 evaluator steps. Array
//! initialisation costs about one step per element, so the two tables below cost ~85k steps before the search
//! starts. Consts that reference other consts share one budget (evidence/probes-*.txt), so each search is its own
//! `static_assert`.

use ingot::escrow::{
    step,
    encode,
    decode,
    action_of,
    state_violation,
    first_violation,
    SIZE,
    ACTIONS,
    INIT,
    CAP,
    OK,
    WITHIN_CAPACITY,
    IN_BOUNDS,
    PAID_ONCE,
    SETTLED_EMPTY,
    CONSERVED,
}

/// Turns an invariant id into a compile error that names the invariant (called only when `v != OK`).
const fn require(_ v: u8) {
    assert!(
        v != WITHIN_CAPACITY,
        "invariant 'within capacity' broken: more units than the capacity",
    )
    assert!(
        v != IN_BOUNDS,
        "invariant 'in bounds' broken: state outside the encoding",
    )
    assert!(
        v != PAID_ONCE,
        "invariant 'paid once' broken: buyer and seller both paid",
    )
    assert!(
        v != SETTLED_EMPTY,
        "invariant 'settled empty' broken: settled with units still in escrow",
    )
    assert!(
        v != CONSERVED,
        "invariant 'conserved' broken: units created or lost by a non-deposit action",
    )
}

/// Number of states reachable from the initial state at capacity `cap`.
pub const fn explore(_ cap: u32) -> usize {
    explore_from(INIT, cap)
}

/// Number of states reachable from `start` (an encoded state) at capacity `cap`. Fails the evaluation, naming
/// the invariant, if any reachable state or edge breaks one.
pub const fn explore_from(_ start: u32, _ cap: u32) -> usize {
    var visited: [bool; SIZE] = [false; SIZE]
    // Each index is enqueued only when it is first marked visited, so the queue never holds more than SIZE.
    var queue: [u32; SIZE] = [0; SIZE]
    var head: usize = 0
    var tail: usize = 1
    let v0 = state_violation(decode(start), cap)
    if v0 != OK { require(v0) }
    queue[0] = start
    visited[start as usize] = true
    while head < tail {
        let x = queue[head]
        head += 1
        let cur = decode(x)
        var a: u32 = 0
        while a < ACTIONS {
            let act = action_of(a)
            let n = step(cur, act, cap)
            if n.ok {
                // Every invariant is checked before `encode`, so an out-of-box successor fails by name.
                let v = first_violation(cur, act, n.s, cap)
                if v != OK { require(v) }
                let y = encode(n.s)
                if !visited[y as usize] {
                    visited[y as usize] = true
                    queue[tail] = y
                    tail += 1
                }
            }
            a += 1
        }
    }
    tail
}

/// Code returned when the start state itself breaks an invariant (no action uses the digit 9).
pub const START_VIOLATES: u256 = 9

/// The same search, recording each state's parent and the action that reached it. Returns the first shortest
/// counterexample under the declared action order, across all checked invariants, as decimal digits (earliest
/// action first; legend in `escrow.fe`), or 0 when no reachable state or edge breaks an invariant.
pub const fn counterexample(_ cap: u32) -> u256 {
    if state_violation(decode(INIT), cap) != OK {
        return START_VIOLATES
    }
    var visited: [bool; SIZE] = [false; SIZE]
    var parent: [u32; SIZE] = [0; SIZE]
    var via: [u8; SIZE] = [0; SIZE]
    var queue: [u32; SIZE] = [0; SIZE]
    var head: usize = 0
    var tail: usize = 1
    queue[0] = INIT
    visited[INIT as usize] = true
    while head < tail {
        let x = queue[head]
        head += 1
        let cur = decode(x)
        var a: u32 = 0
        while a < ACTIONS {
            let act = action_of(a)
            let n = step(cur, act, cap)
            if n.ok {
                if first_violation(cur, act, n.s, cap) != OK {
                    // BFS order: this edge ends the shortest path to a violation. Walk back from the current state.
                    var code: u256 = (a + 1) as u256
                    var mul: u256 = 10
                    var len: u32 = 1
                    var p = x
                    while p != INIT {
                        len += 1
                        // A u256 holds every decimal number of at most 77 digits; stop before the multiplication overflows.
                        assert!(
                            len <= 76,
                            "trace longer than 76 actions: shrink the configuration to print it",
                        )
                        code += (via[p as usize] as u256) * mul
                        mul *= 10
                        p = parent[p as usize]
                    }
                    return code
                }
                let y = encode(n.s)
                if !visited[y as usize] {
                    visited[y as usize] = true
                    parent[y as usize] = x
                    via[y as usize] = (a + 1).downcast_truncate()
                    queue[tail] = y
                    tail += 1
                }
            }
            a += 1
        }
    }
    0
}

// ---- pins: the build fails if the reachable-state count drifts ----
/// C = 17: the capacity of the first pin, carried over from the day-0 spike (494 states).
static_assert(explore(17) == 494)
/// C = CAP = 21: the contract's capacity and the largest capacity the encoding holds (MAX_CAP). Every invariant is
/// checked on every reachable state and accepted edge; this fits one assert's budget on Fe 26.6.0 (evidence/budget.md).
static_assert(explore(CAP) == 736)
/// C' = 20: the attack printer. Green it is a full search with parent/action writes (four tables), so it fits a
/// smaller capacity than `explore`; C = 21 exceeds the step limit (measured, see evidence/budget.md).
static_assert(counterexample(20) == 0)
