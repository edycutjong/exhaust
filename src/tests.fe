//! Tests. `fe test` runs them on Sonatina (EVM); `fe test --backend native` runs the ones without
//! `#[cfg(target = "evm")]` natively. The runtime searches call the same `explore_from()` the build ran;
//! `black_box` hides the start state so the search cannot be folded at compile time.

use core::hint::black_box
use std::evm::Evm
use ingot::escrow::{
    State,
    Phase,
    step,
    encode,
    decode,
    action_of,
    action_id,
    initial,
    phase_id,
    CAP,
    ACTIONS,
    INIT,
    W,
    SIZE,
}
use ingot::escrow_explore::{explore_from, explore_seeds, counterexample, LOCKED_BASE, LOCKED_STRIDE}
use ingot::escrow_contract::{Escrow, EscrowMsg}

// ---- both backends ----

/// The runtime search agrees with the compile-time pins (C = 17 and C = CAP).
#[test]
fn test_runtime_explore_agrees() {
    assert!(explore_from(black_box(INIT), black_box(17 as u32)) == 494)
    assert!(explore_from(black_box(INIT), black_box(CAP)) == 736)
}

/// The three locked-amount shards plus the C + 1 Open states add up to the single search's count at C = CAP (the
/// shards are disjoint: after Lock the total is fixed). Also every shard count matches its compile-time pin.
#[test]
fn test_shards_partition() {
    let a = explore_seeds(
        black_box(LOCKED_BASE + LOCKED_STRIDE),
        7,
        LOCKED_STRIDE,
        black_box(CAP),
    )
    let b = explore_seeds(
        black_box(LOCKED_BASE + 8 * LOCKED_STRIDE),
        7,
        LOCKED_STRIDE,
        black_box(CAP),
    )
    let c = explore_seeds(
        black_box(LOCKED_BASE + 15 * LOCKED_STRIDE),
        7,
        LOCKED_STRIDE,
        black_box(CAP),
    )
    assert!(a == 91 && b == 238 && c == 385)
    let open = (CAP + 1) as usize
    assert!(
        a + b + c + open == explore_from(black_box(INIT), black_box(CAP)),
    )
}

/// The attack printer finds nothing at runtime either.
#[test]
fn test_counterexample_none() {
    assert!(counterexample(black_box(19 as u32)) == 0)
}

/// encode(decode(x)) == x for every 97th index of the box, and decode(encode(s)) == s for one boundary state.
#[test]
fn test_encode_roundtrip() {
    var x: u32 = 0
    while x < 42592 {
        let s = decode(x)
        assert!(encode(s) == x)
        x += 97
    }
    let s = State { phase: Phase::Disputed, escrow: W - 1, seller: 0, buyer: 3 }
    let t = decode(encode(s))
    assert!(
        phase_id(t.phase) == 2 && t.escrow == W - 1 && t.seller == 0 && t.buyer == 3,
    )
}

/// Every action id in 0..ACTIONS maps to a distinct action and back.
#[test]
fn test_action_ids_distinct() {
    var i: u32 = 0
    while i < ACTIONS {
        assert!(action_id(action_of(i)) == i)
        i += 1
    }
}

// ---- EVM only: the deployed contract ----

#[cfg(target = "evm")]
fn send(evm: mut Evm, _ addr: Address, _ a: u32) -> bool {
    if a == 0 {
        return evm.call(
            addr: addr,
            gas: 200000,
            value: Wei::zero(),
            message: EscrowMsg::Deposit {},
        )
    }
    if a == 1 {
        return evm.call(
            addr: addr,
            gas: 200000,
            value: Wei::zero(),
            message: EscrowMsg::Lock {},
        )
    }
    if a == 2 {
        return evm.call(
            addr: addr,
            gas: 200000,
            value: Wei::zero(),
            message: EscrowMsg::Release {},
        )
    }
    if a == 3 {
        return evm.call(
            addr: addr,
            gas: 200000,
            value: Wei::zero(),
            message: EscrowMsg::Refund {},
        )
    }
    evm.call(
        addr: addr,
        gas: 200000,
        value: Wei::zero(),
        message: EscrowMsg::Dispute {},
    )
}

/// The day-0 spike's 8-call script: after every call the contract's answer and stored state match `step()`.
#[cfg(target = "evm")]
#[test]
fn test_contract_matches_step() uses (evm: mut Evm) {
    let addr = evm.create2<Escrow>(value: Wei::zero(), args: (), salt: 0)
    // Deposit, Deposit, Release (rejected: not locked), Lock, Release, Refund (rejected: seller paid),
    // Dispute (rejected: seller paid), Release
    let script: [u32; 8] = [0, 0, 2, 1, 2, 3, 4, 2]
    var model = initial()
    var i: usize = 0
    while i < 8 {
        let a = script[i]
        let ok = send(mut evm, addr, a)
        let n = step(model, action_of(a), CAP)
        assert!(ok == n.ok)
        if n.ok { model = n.s }
        let onchain: u256 = evm
            .call(
                addr: addr,
                gas: 100000,
                value: Wei::zero(),
                message: EscrowMsg::GetState {},
            )
        assert!(onchain == encode(model) as u256)
        i += 1
    }
    // Two units to the seller, settled.
    assert!(
        model.buyer == 0 && model.seller == 2 && phase_id(model.phase) == 3,
    )
    let raw: u256 = evm
        .call(
            addr: addr,
            gas: 100000,
            value: Wei::zero(),
            message: EscrowMsg::RawState {},
        )
    assert!(raw == 3 | (2 << 128))
}

#[cfg(target = "evm")]
#[event]
struct GasUsed { runtime_search_gas: u256, states: u256 }

/// The runtime search really runs: it reports the gas it used.
#[cfg(target = "evm")]
#[test]
fn test_runtime_search_gas() uses (ctx: std::evm::Ctx, log: mut std::evm::Log) {
    let before = ctx.gas()
    let n = black_box(explore_from(black_box(INIT), black_box(17 as u32)))
    let used = before - ctx.gas()
    log.emit(GasUsed { runtime_search_gas: used, states: n as u256 })
    assert!(n == 494)
    // Measured: 16,394,182 gas on Fe 26.6.0 (evidence/p1b-core-2026-11-21.md). A search folded away at compile time would cost almost nothing.
    assert!(used > 1000000)
}

// ---- EVM only: per-handler suite, written from MODEL.md's action table (happy path + the phase guard) ----

#[cfg(target = "evm")]
fn read_raw(evm: mut Evm, _ addr: Address) -> u256 {
    evm.call(
        addr: addr,
        gas: 100000,
        value: Wei::zero(),
        message: EscrowMsg::RawState {},
    )
}

/// The raw_state() word for (phase id, escrow, seller, buyer).
#[cfg(target = "evm")]
fn raw_of(_ p: u256, _ e: u256, _ s: u256, _ b: u256) -> u256 {
    p | (e << 64) | (s << 128) | (b << 192)
}

/// Deposit: accepted while Open, adds one unit to escrow; rejected once Locked.
#[cfg(target = "evm")]
#[test]
fn test_handler_deposit() uses (evm: mut Evm) {
    let addr = evm.create2<Escrow>(value: Wei::zero(), args: (), salt: 101)
    assert!(send(mut evm, addr, 0))
    assert!(read_raw(mut evm, addr) == raw_of(0, 1, 0, 0))
    assert!(send(mut evm, addr, 0))
    assert!(read_raw(mut evm, addr) == raw_of(0, 2, 0, 0))
    assert!(send(mut evm, addr, 1))
    assert!(!send(mut evm, addr, 0))
    assert!(read_raw(mut evm, addr) == raw_of(1, 2, 0, 0))
}

/// Lock: rejected with nothing in escrow; accepted after a deposit, the phase becomes Locked.
#[cfg(target = "evm")]
#[test]
fn test_handler_lock() uses (evm: mut Evm) {
    let addr = evm.create2<Escrow>(value: Wei::zero(), args: (), salt: 102)
    assert!(!send(mut evm, addr, 1))
    assert!(read_raw(mut evm, addr) == raw_of(0, 0, 0, 0))
    assert!(send(mut evm, addr, 0))
    assert!(send(mut evm, addr, 1))
    assert!(read_raw(mut evm, addr) == raw_of(1, 1, 0, 0))
    assert!(!send(mut evm, addr, 1))
}

/// Release: rejected while Open; once Locked each call pays the seller one unit, the last one settles.
#[cfg(target = "evm")]
#[test]
fn test_handler_release() uses (evm: mut Evm) {
    let addr = evm.create2<Escrow>(value: Wei::zero(), args: (), salt: 103)
    assert!(send(mut evm, addr, 0))
    assert!(send(mut evm, addr, 0))
    assert!(!send(mut evm, addr, 2))
    assert!(send(mut evm, addr, 1))
    assert!(send(mut evm, addr, 2))
    assert!(read_raw(mut evm, addr) == raw_of(1, 1, 1, 0))
    assert!(send(mut evm, addr, 2))
    assert!(read_raw(mut evm, addr) == raw_of(3, 0, 2, 0))
    assert!(!send(mut evm, addr, 2))
}

/// Refund: rejected while Open; once Locked each call returns one unit to the buyer, the last one settles.
#[cfg(target = "evm")]
#[test]
fn test_handler_refund() uses (evm: mut Evm) {
    let addr = evm.create2<Escrow>(value: Wei::zero(), args: (), salt: 104)
    assert!(send(mut evm, addr, 0))
    assert!(send(mut evm, addr, 0))
    assert!(!send(mut evm, addr, 3))
    assert!(send(mut evm, addr, 1))
    assert!(send(mut evm, addr, 3))
    assert!(read_raw(mut evm, addr) == raw_of(1, 1, 0, 1))
    assert!(send(mut evm, addr, 3))
    assert!(read_raw(mut evm, addr) == raw_of(3, 0, 0, 2))
    assert!(!send(mut evm, addr, 3))
}

/// Dispute: rejected while Open; accepted when Locked; a disputed escrow can still be refunded.
#[cfg(target = "evm")]
#[test]
fn test_handler_dispute() uses (evm: mut Evm) {
    let addr = evm.create2<Escrow>(value: Wei::zero(), args: (), salt: 105)
    assert!(send(mut evm, addr, 0))
    assert!(!send(mut evm, addr, 4))
    assert!(send(mut evm, addr, 1))
    assert!(send(mut evm, addr, 4))
    assert!(read_raw(mut evm, addr) == raw_of(2, 1, 0, 0))
    assert!(send(mut evm, addr, 3))
    assert!(read_raw(mut evm, addr) == raw_of(3, 0, 0, 1))
}

// ---- EVM only: the exhaustive-edge differential (X5) ----

/// Asserts that a raw_state() word holds a valid state (every lane in bounds, phase < 4) equal to `m`, lane by lane.
#[cfg(target = "evm")]
fn check_raw(_ raw: u256, _ m: State) {
    let mask: u256 = (1 << 64) - 1
    let p = raw & mask
    let e = (raw >> 64) & mask
    let se = (raw >> 128) & mask
    let b = raw >> 192
    let w = W as u256
    assert!(p < 4 && e < w && se < w && b < w)
    assert!(p == phase_id(m.phase) as u256)
    assert!(
        e == m.escrow as u256 && se == m.seller as u256 && b == m.buyer as u256,
    )
}

/// Deploys a fresh escrow (salt = `salt`) and drives it along `path` (action digits, last action at index 0),
/// checking the contract's answer and raw state against `step()` after every call. Returns the address.
#[cfg(target = "evm")]
fn replay(evm: mut Evm, _ salt: u256, _ path: [u8; 64], _ len: usize) -> Address {
    let addr = evm.create2<Escrow>(value: Wei::zero(), args: (), salt: salt)
    var m = initial()
    var i = len
    while i > 0 {
        i -= 1
        let a = (path[i] - 1) as u32
        let n = step(m, action_of(a), CAP)
        assert!(n.ok)
        assert!(send(mut evm, addr, a))
        check_raw(read_raw(mut evm, addr), n.s)
        m = n.s
    }
    addr
}

#[cfg(target = "evm")]
#[event]
struct DifferentialRun {
    cap: u256,
    states: u256,
    edges: u256,
    attempts: u256,
    deployments: u256,
    action_calls: u256,
    reads: u256,
}

/// Every reachable transition attempt at the contract's capacity, replayed through the deployed contract. For each
/// reachable state s (BFS order, the same search `explore` runs): a fresh deployment is driven to s along its BFS
/// path (every path step compared), every rejected action is tried first (the contract must refuse it and leave
/// all four stored fields unchanged), then the first accepted action; each further accepted action at s gets its
/// own fresh deployment. After every call the contract's `ok` and its raw stored fields must equal `step()`.
#[cfg(target = "evm")]
#[test]
fn test_differential_all_edges() uses (evm: mut Evm, log: mut std::evm::Log) {
    var visited: [bool; SIZE] = [false; SIZE]
    var parent: [u32; SIZE] = [0; SIZE]
    var via: [u8; SIZE] = [0; SIZE]
    var queue: [u32; SIZE] = [0; SIZE]
    var path: [u8; 64] = [0; 64]
    var head: usize = 0
    var tail: usize = 1
    queue[0] = INIT
    visited[INIT as usize] = true
    var edges: u256 = 0
    var deployments: u256 = 0
    var calls: u256 = 0
    while head < tail {
        let x = queue[head]
        head += 1
        let cur = decode(x)
        var len: usize = 0
        var p = x
        while p != INIT {
            path[len] = via[p as usize]
            len += 1
            p = parent[p as usize]
        }
        let first = replay(mut evm, deployments, path, len)
        deployments += 1
        calls += len as u256
        // Rejected actions first: refused, nothing stored changes.
        var a: u32 = 0
        while a < ACTIONS {
            let n = step(cur, action_of(a), CAP)
            if !n.ok {
                assert!(!send(mut evm, first, a))
                check_raw(read_raw(mut evm, first), cur)
                calls += 1
            }
            a += 1
        }
        // Accepted actions: the first on this deployment, each further one on a fresh deployment.
        var used = false
        a = 0
        while a < ACTIONS {
            let n = step(cur, action_of(a), CAP)
            if n.ok {
                var addr = first
                if used {
                    addr = replay(mut evm, deployments, path, len)
                    deployments += 1
                    calls += len as u256
                }
                used = true
                assert!(send(mut evm, addr, a))
                check_raw(read_raw(mut evm, addr), n.s)
                calls += 1
                edges += 1
                let y = encode(n.s)
                if !visited[y as usize] {
                    visited[y as usize] = true
                    parent[y as usize] = x
                    via[y as usize] = (a + 1).downcast_truncate()
                    queue[tail] = y
                    tail += 1
                }
            }
            a += 1
        }
    }
    log.emit(
        DifferentialRun {
            cap: CAP as u256,
            states: tail as u256,
            edges,
            attempts: 5 * tail as u256,
            deployments,
            action_calls: calls,
            reads: calls,
        },
    )
    // Pinned from the oracle (tools/ref_model.py, written from MODEL.md), not from this test's own output.
    assert!(tail == 736 && edges == 966)
    assert!(deployments == 1008 && calls == 25646)
}

// ---- EVM only: the attack the compiler printed, replayed on the real contract ----

/// Digits 1 1 2 3 4 (Deposit, Deposit, Lock, Release, Refund), the counterexample `fe build` prints when the Refund
/// guard loses `seller == 0` (demo/refund-after-release.patch). On the unpatched contract the first four calls are
/// accepted and the Refund is refused, leaving every stored field unchanged.
#[cfg(target = "evm")]
#[test]
fn test_contract_rejects_attack() uses (evm: mut Evm) {
    let addr = evm.create2<Escrow>(value: Wei::zero(), args: (), salt: 201)
    let attack: [u32; 5] = [0, 0, 1, 2, 3]
    var i: usize = 0
    while i < 4 {
        assert!(send(mut evm, addr, attack[i]))
        i += 1
    }
    let before = read_raw(mut evm, addr)
    assert!(before == raw_of(1, 1, 1, 0))
    assert!(!send(mut evm, addr, attack[4]))
    assert!(read_raw(mut evm, addr) == before)
}
